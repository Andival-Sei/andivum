{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andivum.example/schemas/finance-transaction.json",
  "title": "Finance transaction command",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "occurred_on", "currency", "total_minor", "items"],
  "properties": {
    "type": { "enum": ["income", "expense", "transfer"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "occurred_on": { "type": "string", "format": "date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total_minor": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity", "unit_price_minor", "line_total_minor", "category_slug"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit_price_minor": { "type": "integer", "minimum": 0 },
          "line_total_minor": { "type": "integer", "minimum": 0 },
          "category_slug": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
