{
  "name": "andivum-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Developer command facade for the Andivum monorepo",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node tools/scripts/doctor.mjs",
    "test": "node --test tools/scripts/*.test.mjs",
    "check": "pnpm test && pnpm api:test && pnpm windows:test && node tools/scripts/check-foundation.mjs",
    "check:foundation": "node tools/scripts/check-foundation.mjs",
    "api:build": "dotnet build services/api/Andivum.Api/Andivum.Api.csproj",
    "api:test": "node tools/scripts/run-api-tests.mjs",
    "windows:test": "dotnet test apps/windows.tests/Andivum.Windows.Tests.csproj",
    "windows:build": "dotnet build apps/windows/Andivum.Windows.csproj -p:Platform=x64",
    "windows:run": "node tools/scripts/run-windows.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/scripts/run-android-gradle.ps1 assembleDebug",
    "android:build:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/scripts/run-android-gradle.ps1 -Cloud assembleDebug",
    "android:build:physical": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/scripts/run-android-gradle.ps1 -ApiBaseUrl https://localhost:7240 assembleDebug",
    "dev:infra": "docker compose --env-file .env -f infra/compose/docker-compose.yml up -d --wait",
    "dev:api": "node tools/scripts/run-api.mjs"
  }
}
