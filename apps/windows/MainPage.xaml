<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Andivum_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Andivum_Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
        <TextBlock
            Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="Sign in once to access your tasks and finances on every device."
            TextWrapping="Wrap"
            Style="{StaticResource BodyTextBlockStyle}" />
        <Button
            Content="Continue with passkey"
            Command="{x:Bind ViewModel.SignInCommand}"
            HorizontalAlignment="Left" />
        <Button
            Content="Sign out"
            Command="{x:Bind ViewModel.SignOutCommand}"
            HorizontalAlignment="Left" />
        <TextBlock
            Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}"
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</Page>
